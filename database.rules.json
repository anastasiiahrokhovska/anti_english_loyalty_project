{
  "rules": {
    ".read": false,
    ".write": false,
    "channel_accounts": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "taken_topics": {
      ".read": "auth != null",
      ".write": false
    },
    "topic_locks": {
      ".read": false,
      ".write": false
    }
  }
}
